{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["supabase"],
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run tsc)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:run)",
      "Bash(npm run test:clean)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx eslint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)"
    ],
    "ask": [
      "Bash(npm run release)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "PowerShell(git push * main*)",
      "PowerShell(git push *:main*)"
    ]
  }
}
