{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `e2e` is included deliberately. It used to be checked by nothing at all —
  // not this config, not tsconfig.test.json, not vitest (which excludes e2e/**),
  // and not Playwright, which transpiles with esbuild and never type-checks. So
  // the four Definition-of-Done gates in CLAUDE.md all passed over it. That is
  // how `restoreConfig(app, snapshot)` kept an unused parameter and how
  // `patchMCCollection` compared a numeric id against a string. Both are the
  // kind of thing `noUnusedParameters` and a union check catch for free.
  "include": ["src", "electron", "e2e"],
  "exclude": [
    "src/**/__tests__/*",
    "src/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/test/**/*"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
